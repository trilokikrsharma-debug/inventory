[Unit]
Description=InvenBill Scheduler Task Runner
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/tsalegacy
ExecStart=/usr/bin/php /var/www/tsalegacy/cli/scheduler.php --task=all
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/www/tsalegacy/cache /var/www/tsalegacy/logs /var/www/tsalegacy/uploads
UMask=0027
StandardOutput=append:/var/www/tsalegacy/logs/scheduler.log
StandardError=append:/var/www/tsalegacy/logs/scheduler-error.log
