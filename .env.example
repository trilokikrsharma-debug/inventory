# InvenBill Pro environment template
# Copy this file to .env and fill production-specific values.

# Application
APP_NAME=InvenBill
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.example.com
ASSET_BUILD=20260402
LOG_CHANNEL=stderr

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=invenbill_prod
DB_USER=invenbill_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Tenant routing (subdomain-based multi-tenancy)
TENANT_BASE_DOMAIN=example.com
TENANT_HOST_ENFORCEMENT=true
TENANT_ALLOW_LOCALHOST_FALLBACK=false
TENANT_AUTO_SYNC_SUBSCRIPTION_STATUS=true

# Security and session
SESSION_LIFETIME=7200
SESSION_IDLE_TIMEOUT=1800
HEALTH_PUBLIC_MODE=false
# Legacy alias supported by middleware/controller checks
# HEALTH_ALLOW_PUBLIC=false

# Demo mode (optional). If empty, a random password is generated for demo user bootstrap.
DEMO_PASSWORD=

# Redis (cache + session + queue)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Legacy alias supported in RateLimiter
# REDIS_PASS=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_PREFIX=invenbill:

# Razorpay
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Mail (optional)
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME="${APP_NAME}"
