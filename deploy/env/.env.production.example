APP_NAME=InvenBill
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.example.com
ASSET_BUILD=20260318
LOG_CHANNEL=stderr

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_billing
DB_USER=invenbill_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Tenant routing (required for tenant1.example.com)
TENANT_BASE_DOMAIN=example.com
TENANT_HOST_ENFORCEMENT=true
TENANT_ALLOW_LOCALHOST_FALLBACK=false
TENANT_AUTO_SYNC_SUBSCRIPTION_STATUS=true

# Security / Sessions
SESSION_LIFETIME=7200
SESSION_IDLE_TIMEOUT=1800
HEALTH_PUBLIC_MODE=false
# Keep false in production; health is blocked at the web server by default.

# Redis cache/queue
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_PREFIX=invenbill:

# Razorpay (LIVE)
RAZORPAY_KEY=rzp_live_xxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Optional mail transport vars can be added if mail() is replaced by SMTP later.
