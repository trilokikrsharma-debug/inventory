[Unit]
Description=InvenBill Scheduler Task Runner
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/tsalegacy
ExecStart=/usr/bin/php /var/www/tsalegacy/cli/scheduler.php --task=all
StandardOutput=append:/var/www/tsalegacy/logs/scheduler.log
StandardError=append:/var/www/tsalegacy/logs/scheduler-error.log
